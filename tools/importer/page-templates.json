        {
          "name": "cards-category",
          "instances": [
            "body > main.container-v3 > div.deals-by-categories"
          ]
        },
        {
          "name": "cards-offer",
          "instances": [
            "body > main.container-v3 > div.relative.overflow-hidden:nth-of-type(4) div.grid.gap-200.mx-200"
          ]
        },
